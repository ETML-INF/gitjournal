<div class="overlay" id="statsOverlay">
  <div class="modal" style="max-width: 400px">
    <h2>Statistiques</h2>
    <% if (owner && repo) { %>
    <p style="margin: 0.5rem 0; font-size: 0.9em;">
      • Commits de l'utilisateur lus depuis le dépôt local : <strong><%= commitStats.fromUser %></strong><br>
      • Commits avec métadonnées : <strong><%= commitStats.withMetadata %></strong><br>
      <% if (commitStats.issueComments || commitStats.issuesError) { %>
      • Commentaires d'issues : <strong><%= commitStats.issueComments %></strong><br>
      <% } %>
      <% if (commitStats.issuesError) { %>
      • <span style="color: #c00">Issues non lues.</span> <%= commitStats.issuesError %><br>
      <% } %>
      • Après exclusions : <strong><%= commitStats.afterExclusions %></strong><br>
      • Entrées manuelles : <strong><%= commitStats.manualEntries %></strong><br>
      <br>
      <strong>Total affiché : <%= commitStats.total %></strong>
    </p>
    <% } else { %>
    <p style="margin: 0.5rem 0; font-size: 0.9em;">
      Aucun repository Git configuré.<br>
      Entrées manuelles : <strong><%= commitStats.manualEntries %></strong>
    </p>
    <% } %>
  </div>
</div>
